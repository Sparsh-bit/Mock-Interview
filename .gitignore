node_modules/
.next/
__pycache__/
*.pyc
.venv/
venv/
.env
.env.local
# ANY sibling of .env, not just the two named forms.
#
# A backup made before editing .env — `.env.bak`, `.env.2026-08-22`, `.env.old` — holds every
# secret the real file does, and `git add -A` picks it up because only the exact names above
# were ignored. That happened: a `.env.bak.<timestamp>` written by a one-line edit landed in a
# commit and was caught by GitHub's push protection on an Anthropic key, which is the only
# reason it did not reach the remote. A pattern is the fix; remembering is not.
.env.*
!.env.example
dist/
build/
.DS_Store
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
backend/.coverage
.coverage
frontend/tsconfig.tsbuildinfo

# Cloudflare/Vercel build output
.vercel/

# Staged at build time from frontend/public (see root vercel-build script)
/public/

# Stray screenshots dropped in the repo root (canonical copy lives in frontend/public)
/Screenshot*.png

# Promo video project — local only, never pushed to GitHub.
# Contains the Remotion motion-graphics source plus large rendered mp4s and
# licensed audio, none of which belong in the app repo.
/promo/

# graphify scratch — machine-generated extraction cache and chunk files.
# 3.7MB of it got committed once; never again. Nothing in the app reads it, and
# it records absolute paths from whichever machine ran the tool.
/graphify-out/

# Redis snapshot, written by a locally-run redis-server
dump.rdb

# Loose photos dropped in the repo root. Real image assets live in frontend/public/img,
# which is where the landing page reads them from; a 5MB JPG sat here tracked for months
# and referenced by nothing.
/*.jpg
/*.jpeg
/*.png

# The Obsidian vault's per-machine UI state — open panes, window size, last file viewed.
# The vault IS this repo, so without these every clone fights over somebody else's window
# layout. The settings that are worth sharing (graph config, enabled core plugins) are
# tracked deliberately.
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Obsidian scratch canvases created by a stray click in the vault. Two empty ones were
# committed by a `git add -A`; a canvas that is genuinely wanted can be force-added.
Untitled*.canvas

# Claude Code's per-machine local settings — has held a live API key in this repo
# before; settings.json (shared, no secrets) stays tracked, this does not.
.claude/settings.local.json
