# ==============================================================================
# InterviewOS — Environment Variables
# ==============================================================================

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME="InterviewOS"
DEBUG=True
LOG_LEVEL=INFO
LOG_FORMAT=console

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
# For local dev via docker-compose:
REDIS_URL=redis://localhost:6379/0

# ── Supabase ──────────────────────────────────────────────────────────────────
# Required for Auth and Storage. Get these from Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── AI Provider (GLM 5.2 - NVIDIA NIM) ───────────────────────────────────────────
AI_PROVIDER=glm
GLM_API_KEY=your-nvidia-nim-api-key
GLM_MODEL=z-ai/glm-5.2
GLM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── API URLs ──────────────────────────────────────────────────────────────────
# Used by frontend to call backend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Used by Next.js rewrites in dev
INTERNAL_API_URL=http://localhost:8000
