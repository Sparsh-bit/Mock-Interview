# ==============================================================================
# InterviewOS — Environment Variables
# ==============================================================================

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME="InterviewOS"
DEBUG=True
LOG_LEVEL=INFO
LOG_FORMAT=console

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
# For local dev via docker-compose:
REDIS_URL=redis://localhost:6379/0

# ── Supabase ──────────────────────────────────────────────────────────────────
# Required for Auth and Storage. Get these from Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── AI Provider (GLM via ZhipuAI direct API) ─────────────────────────────────
# Get a key from open.bigmodel.cn. glm-5.2 requires a funded account balance;
# glm-4.5-flash is available on the free tier.
AI_PROVIDER=glm
GLM_API_KEY=your-zhipuai-api-key
GLM_MODEL=glm-4.5-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── AI Provider (alternate: NVIDIA NIM) ──────────────────────────────────────
# Get a free key from build.nvidia.com. Set AI_PROVIDER=nvidia to use this
# instead of GLM. Large reasoning models here are slower per-call than GLM's
# flash tier -- verify latency for your chosen model before relying on it.
NVIDIA_API_KEY=your-nvidia-nim-api-key
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── API URLs ──────────────────────────────────────────────────────────────────
# Used by frontend to call backend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Used by Next.js rewrites in dev
INTERNAL_API_URL=http://localhost:8000
