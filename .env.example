# ==============================================================================
# Hotseat — Environment Variables
# ==============================================================================

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME="Hotseat"
DEBUG=True
LOG_LEVEL=INFO
LOG_FORMAT=console

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres
# The pooler's limit on simultaneous client connections (Supabase dashboard -> Database ->
# Connection pooling). Startup checks (DB_POOL_SIZE + DB_MAX_OVERFLOW) x WEB_REPLICA_COUNT
# against it and WARNS — it never crashes, because an over-subscribed pool still serves
# every request that gets a connection. Left at 0 nothing is checked and startup says so.
DB_CONNECTION_CEILING=0

# ── Redis ─────────────────────────────────────────────────────────────────────
# For local dev via docker-compose:
REDIS_URL=redis://localhost:6379/0
# Managed Redis requires TLS. Use the rediss:// URL the provider gives you, not the
# redis:// one — over the public internet the plaintext scheme sends the AUTH password
# and every cached value in the clear. Startup logs `redis_plaintext_in_production` if
# ENVIRONMENT=production and this is still redis:// against a non-localhost host.
#   REDIS_URL=rediss://default:password@your-instance.example.com:6379
#
# The provider's simultaneous-connection limit, off your plan page. Left at 0 nothing is
# checked and startup says so; set it and startup verifies
# REDIS_MAX_CONNECTIONS x WEB_REPLICA_COUNT against it. See docs/REDIS-CUTOVER.md.
REDIS_CONNECTION_CEILING=0
# Only if the provider presents a certificate the system trust store does not chain to.
# Ignored for a plaintext redis:// URL.
# REDIS_TLS_CA_CERTS=/etc/ssl/certs/provider-ca.pem

# ── Deployment topology ───────────────────────────────────────────────────────
# How many copies of the API the platform runs. Nothing changes behaviour off this —
# it is what the startup audits multiply per-process connection budgets by, since a
# process cannot see its siblings. Keep it equal to numInstances in render.yaml.
WEB_REPLICA_COUNT=1

# ── Supabase ──────────────────────────────────────────────────────────────────
# Required for Auth and Storage. Get these from Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── AI Provider (GLM via ZhipuAI direct API) ─────────────────────────────────
# Get a key from open.bigmodel.cn. glm-5.2 requires a funded account balance;
# glm-4.5-flash is available on the free tier.
# AI_FALLBACK_PROVIDER is tried automatically when the primary fails or returns
# unusable output (empty allowlist string disables it). Two free providers give
# double the effective capacity + resilience under concurrent load.
AI_PROVIDER=glm
AI_FALLBACK_PROVIDER=nvidia
GLM_API_KEY=your-zhipuai-api-key
GLM_MODEL=glm-4.5-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── AI Provider (alternate/fallback: NVIDIA NIM) ─────────────────────────────
# Get a free key from build.nvidia.com. Used as the fallback by default, or set
# AI_PROVIDER=nvidia to make it primary. Large reasoning models here are slower
# per-call than GLM's flash tier -- verify latency for your chosen model.
NVIDIA_API_KEY=your-nvidia-nim-api-key
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Burst rung: an optional free tier BEHIND the paid chain ───────────────────
# A third provider tried only after AI_PROVIDER and AI_FALLBACK_PROVIDER have both failed,
# and even then only for calls that pass BOTH gates in services/ai/burst_rung.py: the CHEAP
# cost tier AND an explicit allowlist that today holds panel dialogue and nothing else.
# Reports, scoring, cross-questions and model answers can never reach it.
#
# IT IS NOT CAPACITY. Groq's free plan for openai/gpt-oss-20b is 30 RPM / 1,000 requests a
# day / 8,000 tokens a minute (checked 2026-08-30 — these change, so re-check rather than
# trusting this comment). A panel turn is ~3.5k tokens, so that is roughly TWO turns a
# minute against the 3.25 one live GD round produces: a single round does not fit.
#
# Leave AI_BURST_PROVIDER empty to disable it entirely. That is the default, and with no key
# set the provider chain behaves exactly as it did before this existed.
AI_BURST_PROVIDER=
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Code execution (self-hosted Piston) ─────────────────────────────────────
# Run `docker compose up -d piston` then `bash backend/scripts/install_piston_runtimes.sh`.
# The public Piston API (emkc.org) is whitelist-only, so we self-host.
PISTON_BASE_URL=http://localhost:2000/api/v2

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
# Every one of these is EMPTY BY DEFAULT and every one fails CLOSED, so a
# deployment without them works normally except that nothing can be bought.
#
# The KEY_ID is meant to reach the browser — the checkout widget needs it. The
# other two are server-side only and are never returned by any endpoint.
# With KEY_ID or KEY_SECRET unset, POST /billing/checkout answers 503
# ("Payments are not configured on this deployment yet") rather than pretending.
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
#
# SEPARATE FROM KEY_SECRET, and set independently in Razorpay's dashboard. This
# is the one mistake in this section that does not announce itself: signing with
# the wrong secret makes every webhook fail verification, which presents as
# payments SUCCEEDING and accounts never being credited. Empty means the webhook
# rejects everything — the correct closed default for a public URL.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── Captcha (Cloudflare Turnstile) ───────────────────────────────────────────
# Only consulted by promo codes that set `requires_captcha` — a public ₹1 or
# 100%-off code is worth farming with a script, and accounts are free.
#
# UNSET MEANS THOSE OFFERS REFUSE, NOT THAT THE CHECK IS WAIVED. Buying with such
# a code returns 400 "This offer needs a human verification step that is not
# available right now" — a captcha that silently stops working is worse than no
# captcha, because the offer was priced on the assumption it was there. If you
# do not want a captcha, clear `requires_captcha` on the offer (Admin -> Offers)
# rather than leaving the key blank and wondering why checkout refuses.
#
# Everything else in the app is unaffected: a deployment with no Turnstile
# account works normally as long as no offer asks for one. Both keys come from
# one free Cloudflare Turnstile widget.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# The SITE key is public by design and belongs in the frontend bundle.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ── API URLs ──────────────────────────────────────────────────────────────────
# Used by frontend to call backend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Used by Next.js rewrites in dev
INTERNAL_API_URL=http://localhost:8000
# Public origin of the frontend, used as Next.js `metadataBase` so Open Graph
# and canonical URLs resolve absolutely. Falls back to https://interviewos.dev,
# so a wrong value here shows up as link previews pointing at the wrong host
# rather than as a broken page.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Error tracking (Sentry) — optional ────────────────────────────────────────
# Both are blank by default and blank is a supported state: nothing initialises,
# nothing warns, and no network call is made. A developer's machine and CI are
# meant to run without them.
#
# A DSN IS NOT A SECRET. It identifies a project and grants permission to send
# events to it, nothing more — the same category as the Supabase anon key. That is
# why the frontend one carries NEXT_PUBLIC_ and is compiled into the bundle: the
# browser has to have it to report anything at all.
#
# Get them from Sentry -> Settings -> Projects -> <project> -> Client Keys (DSN).
# Create TWO projects, one Python and one JavaScript — a shared DSN mixes backend
# and browser stack traces into one issue stream and makes both harder to read.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Tags events in the Sentry UI. The backend takes this from ENVIRONMENT instead.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# ── Data protection contact (DPDP §8(9)–(10)) ─────────────────────────────────
# A NAMED HUMAN, NOT A ROLE MAILBOX. The statute asks who is accountable, and
# "support@" answers a different question.
#
# Empty is a VISIBLE state, not a silent one: /privacy says in as many words that
# no grievance officer has been appointed, and a test asserts the app never
# invents one. That is deliberate — a made-up name in a compliance notice looks
# like the obligation was discharged.
DPO_NAME=
DPO_EMAIL=
# Published SLA for answering a grievance. Change the number here, not in the copy.
GRIEVANCE_RESPONSE_DAYS=30
